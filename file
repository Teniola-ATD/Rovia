<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rovia - Your Complete Career Journey. Simplified.</title>

    <link rel="icon" type="image/png" href="Images/logo.png">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            200: '#bae0fd',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Vector Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-white text-gray-800 antialiased overflow-x-hidden">

    <!-- HEADER / NAVIGATION -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            
            <!-- Local Logo Image Link -->
            <a href="#hero" class="flex items-center">
                <img src="Images/logo.png" alt="ROVIA Logo" class="h-8 sm:h-10 w-auto object-contain">
            </a>

            <!-- Desktop Nav Items -->
            <nav class="hidden md:flex items-center gap-2 bg-gray-50/80 p-1.5 rounded-full border border-gray-100">
                <a href="#hero" class="px-5 py-2 text-sm font-medium text-blue-600 bg-white rounded-full shadow-sm border border-gray-200/60">Home</a>
                <a href="#pillars" class="px-5 py-2 text-sm font-medium text-gray-600 rounded-full hover:text-blue-600">Discover</a>
                <a href="#flow" class="px-5 py-2 text-sm font-medium text-gray-600 rounded-full hover:text-blue-600">Learn</a>
                <a href="#why-rovia" class="px-5 py-2 text-sm font-medium text-gray-600 rounded-full hover:text-blue-600">Community</a>
                <a href="#footer" class="px-5 py-2 text-sm font-medium text-gray-600 rounded-full hover:text-blue-600">Resources</a>
            </nav>

            <!-- Desktop Actions -->
            <div class="hidden md:flex items-center gap-3">
                <button aria-label="Search" class="p-2 text-gray-500 hover:text-blue-600 rounded-full"><i class="fa-solid fa-magnifying-glass"></i></button>
                <a href="#dashboard-section" class="px-5 py-2.5 text-sm font-semibold text-white bg-blue-600 rounded-full shadow-md hover:bg-blue-700">Sign In</a>
                <a href="#dashboard-section" class="px-5 py-2.5 text-sm font-semibold text-blue-600 border border-blue-200 bg-blue-50 rounded-full">Get Started</a>
            </div>

            <!-- Mobile Hamburger Toggle Button -->
            <button id="menu-btn" class="md:hidden p-2.5 text-gray-700 hover:text-blue-600 focus:outline-none" aria-label="Toggle Menu">
                <i class="fa-solid fa-bars text-xl"></i>
            </button>
        </div>

        <!-- Mobile Nav Drawer Menu -->
        <div id="mobile-menu" class="hidden md:hidden absolute top-20 left-0 w-full bg-white border-b border-gray-200 shadow-xl px-6 py-6 space-y-4">
            <a href="#hero" class="mobile-link block text-base font-medium text-blue-600 bg-blue-50 px-4 py-2.5 rounded-lg">Home</a>
            <a href="#pillars" class="mobile-link block text-base font-medium text-gray-700 hover:bg-gray-50 px-4 py-2.5 rounded-lg">Discover</a>
            <a href="#flow" class="mobile-link block text-base font-medium text-gray-700 hover:bg-gray-50 px-4 py-2.5 rounded-lg">Learn</a>
            <a href="#why-rovia" class="mobile-link block text-base font-medium text-gray-700 hover:bg-gray-50 px-4 py-2.5 rounded-lg">Community</a>
            <a href="#footer" class="mobile-link block text-base font-medium text-gray-700 hover:bg-gray-50 px-4 py-2.5 rounded-lg">Resources</a>
            <div class="pt-4 border-t border-gray-100 flex flex-col gap-3">
                <a href="#dashboard-section" class="mobile-link w-full text-center py-3 text-sm font-semibold text-white bg-blue-600 rounded-full shadow-md">Sign In</a>
                <a href="#dashboard-section" class="mobile-link w-full text-center py-3 text-sm font-semibold text-blue-600 bg-blue-50 border border-blue-200 rounded-full">Get Started</a>
            </div>
        </div>
    </header>


    <!-- HERO SECTION -->
    <section id="hero" class="relative overflow-hidden pt-8 pb-16 lg:pt-12 lg:pb-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                
                <!-- Left Content -->
                <div class="lg:col-